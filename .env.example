AETHER_APP_ENV=development
AETHER_HOST=127.0.0.1
AETHER_PORT=8765

# AI provider: openai | gemini | groq
AETHER_AI_PROVIDER=groq
AETHER_AI_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Speech-to-text: local-whisper | deepgram
AETHER_STT_PROVIDER=local-whisper
DEEPGRAM_API_KEY=
TAVILY_API_KEY=

# Keep these files local and never commit them.
AETHER_GOOGLE_OAUTH_CLIENT_FILE=backend/data/google_oauth_client.json
AETHER_GOOGLE_TOKEN_FILE=backend/data/google_token.json
